{
  "model_name": "Qwen-Image-2.1 BF16 text-only independent RGBA effect",
  "randomize_seed": true,
  "output_node": "8",
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_2.1_bf16.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_8b_bf16.safetensors", "type": "qwen_image", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_2.1_vae_bf16.safetensors"}},
    "4": {"class_type": "LoadImage", "inputs": {"image": "{{source}}"}},
    "5": {"class_type": "TextEncodeQwenImage21", "inputs": {"clip": ["2", 0], "prompt": "{{prompt}}", "negative_prompt": "", "resolution": 1024}},
    "6": {"class_type": "KSampler", "inputs": {"model": ["9", 0], "positive": ["5", 0], "negative": ["5", 1], "latent_image": ["10", 0], "seed": 42, "steps": 25, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
    "7": {"class_type": "VAEDecode", "inputs": {"samples": ["6", 0], "vae": ["3", 0]}},
    "8": {"class_type": "SaveImage", "inputs": {"images": ["7", 0], "filename_prefix": "Cosplay/QwenImage21IndependentRGBATextOnly"}},
    "9": {"class_type": "QwenImage21Cache", "inputs": {"model": ["1", 0], "device": "off", "dtype": "default"}},
    "10": {"class_type": "CosplayEmptyQwen21Canvas", "inputs": {"width": 832, "height": 1248, "batch_size": 1}}
  },
  "asset_contract": {
    "role": "effect_layer",
    "method": "text_only_empty_64_channel_canvas_v2",
    "output": "VAEDecode native Qwen21 RGBA head -> SaveImage unchanged",
    "photo_input": "No conditioning image or photo VAE latent. Unconnected LoadImage preserves adapter upload provenance of the empty canvas only.",
    "alpha": "actual generated; reject opaque matte or photo objects",
    "custom_canvas_node": "providers/comfyui/cosplay_effect_canvas.py",
    "cache": "off"
  }
}
