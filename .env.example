# Copy to .env or .env.local. Literal values; no shell expansion.
# Leave unset for %USERPROFILE%/CosplayWorkbench/workspace.
# COSPLAY_WORKSPACE=D:/CosplayStudio/workspace
# COSPLAY_MODEL_REGISTRY=D:/Models/local-models.current.json
# COSPLAY_QWEN_DEPLOY_ROOT=D:/Models/qwen-image-2.1
# Optional GiB reserve when sharing a GPU; unset uses ComfyUI's hardware default.
# COSPLAY_QWEN_RESERVE_VRAM=2
# COSPLAY_DESKTOP_EXE=C:/Apps/CosplayWorkbench/cosplay-workbench.exe
# COSPLAY_BACKEND_URL=http://127.0.0.1:8787
# COSPLAY_REFERENCE_API_KEY=
# COSPLAY_VISION_API_KEY=
